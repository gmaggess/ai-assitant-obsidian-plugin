{
  "name": "ai-writer-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm run test",
    "publish:vault": "npm run verify && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
